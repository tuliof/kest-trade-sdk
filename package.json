{
  "name": "kest-trade-sdk",
  "version": "0.1.0",
  "description": "A TypeScript SDK for the Questrade API, built with Bun",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "author": {
    "name": "Tulio Fernandes",
    "email": "kest-trade-sdk@tulio.ca"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm --packages external && tsc --project tsconfig.build.json",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "test:unit": "bun test ./test/types ./test/http ./test/auth/auth-client.test.ts ./test/accounts/accounts-client.test.ts ./test/market/market-client.test.ts ./test/client.test.ts",
    "test:integration": "bun test integration",
    "test:watch": "bun test --watch",
    "check": "tsc --noEmit && bun run lint && bun run license:check",
    "lint": "biome check .",
    "lint:fix": "bun run format && biome check --write . && bun run license:add",
    "format": "biome format --write .",
    "license:add": "license-check-and-add add -f .licenserc.json",
    "license:check": "license-check-and-add check -f .licenserc.json",
    "prepare": "husky",
    "prepublishOnly": "bun run lint && bun run test:unit && bun run build"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/bun": "^1.3.4",
    "husky": "^9.1.7",
    "license-check-and-add": "^4.0.5",
    "minimatch": "^10.1.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/tuliof/kest-trade-sdk.git"
  },
  "homepage": "https://github.com/tuliof/kest-trade-sdk#readme",
  "bugs": {
    "url": "https://github.com/tuliof/kest-trade-sdk/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "questrade",
    "api",
    "sdk",
    "typescript",
    "bun",
    "trading",
    "financial",
    "stocks",
    "broker"
  ]
}
